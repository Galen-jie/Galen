<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.galen.seckill.mapper.UserMapper">

    <!-- 根据用户名查询用户 -->
    <select id="selectByUsername" resultType="com.galen.seckill.entity.User">
        SELECT * FROM user WHERE username = #{username}
    </select>

    <!-- 根据手机号查询用户 -->
    <select id="selectByPhone" resultType="com.galen.seckill.entity.User">
        SELECT * FROM user WHERE phone = #{phone}
    </select>

    <!-- 根据邮箱查询用户 -->
    <select id="selectByEmail" resultType="com.galen.seckill.entity.User">
        SELECT * FROM user WHERE email = #{email}
    </select>

</mapper>